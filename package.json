{
  "name": "africa-community-village",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-local-db.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test:crud": "tsx scripts/smoke-crud.ts",
    "verify:deployment": "tsx scripts/verify-deployment.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "db:migrate": "prisma migrate deploy",
    "db:advanced": "tsx scripts/apply-database-objects.ts",
    "db:deploy": "npm run db:migrate && npm run db:advanced",
    "db:local:start": "bash scripts/start-local-db.sh"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.9",
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "jose": "^6.1.0",
    "mysql2": "^3.24.6",
    "next": "^16.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "stripe": "^23.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "prisma": "6.12.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
